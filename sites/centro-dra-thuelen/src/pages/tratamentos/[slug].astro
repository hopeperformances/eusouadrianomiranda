---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { Picture } from 'astro:assets';
import { TREATMENTS, UNITS, FAQ, BRAND, wa, type Treatment } from '../../data/site';

export function getStaticPaths() {
  return TREATMENTS.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: Treatment };
const site = Astro.site!.toString().replace(/\/$/, '');
const url = `${site}/tratamentos/${t.slug}/`;
const others = TREATMENTS.filter((x) => x.slug !== t.slug);
const msg = `Olá! Vim pelo site e quero agendar uma avaliação de ${t.title.toLowerCase()} com a Dra. Thuelen.`;
const faq = FAQ.filter((f) => /primeira consulta|Quanto custa|convênio|sedação|unidades/.test(f.q));

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${url}#pagina`,
    url,
    name: t.seoTitle,
    description: t.seoDesc,
    isPartOf: { '@id': `${site}/#site` },
    inLanguage: 'pt-BR',
    breadcrumb: { '@id': `${url}#breadcrumb` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Tratamentos', item: `${site}/#tratamentos` },
      { '@type': 'ListItem', position: 3, name: t.title, item: url },
    ],
  },
  {
    '@type': 'Service',
    '@id': `${url}#servico`,
    name: `${t.title} em Brusque`,
    serviceType: t.title,
    description: t.text,
    url,
    provider: { '@id': `${site}/#organizacao` },
    areaServed: BRAND.areaServed.map((c) => ({ '@type': 'City', name: c })),
    availableChannel: UNITS.map((u) => ({ '@type': 'ServiceChannel', serviceLocation: { '@id': `${site}/#unidade-${u.id}` } })),
  },
];
---
<Base title={t.seoTitle} description={t.seoDesc} schema={schema} ogImage={t.img.src}>
  <section class="phero">
    <div class="phero__img">
      <Picture src={t.img} formats={['avif']} fallbackFormat="webp" widths={[480, 720]} sizes="(min-width: 960px) 46vw, 100vw" alt={t.alt} loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap phero__body">
      <nav class="crumbs" aria-label="Você está em">
        <ol><li><a href="/">Início</a></li><li><a href="/#tratamentos">Tratamentos</a></li><li aria-current="page">{t.title}</li></ol>
      </nav>
      <h1 class="d1 intro" style="font-size:clamp(40px,10vw,76px)">{t.title} em Brusque.</h1>
      <p class="lead intro" style="--d:.1s">{t.hook}</p>
      <div class="btns intro" style="--d:.2s">
        <a class="btn" href={wa(UNITS[0].whatsapp, msg)} target="_blank" rel="noopener" data-pick data-msg={msg}><Icon name="wa" />Agendar avaliação</a>
        <a class="btn btn--line" href="#detalhes">Como funciona</a>
      </div>
    </div>
  </section>

  <section class="sec" id="detalhes">
    <div class="wrap tpage">
      <article class="prose">
        <h2>{t.question}</h2>
        <p>{t.text}</p>
        <h2>É indicado se:</h2>
        <ul class="check">
          {t.forYou.map((f) => <li><Icon name="check" />{f}</li>)}
        </ul>
        <h2>Como é feito com a Dra. Thuelen</h2>
        <p>
          Primeiro vem a avaliação: a Dra. Thuelen conversa sobre o que te incomoda, examina e, se precisar, faz fotos ou
          escaneamento digital. Depois ela explica o plano etapa por etapa, o que será feito e por quê. Para quem tem medo,
          há sedação para crianças e adultos e laser de alta e baixa potência.
        </p>
        <h2>Onde fazer {t.title.toLowerCase()} em Brusque</h2>
        <p>
          No Centro Dra. Thuelen, nas unidades {UNITS.map((u) => `${u.short} (${u.street})`).join(' e ')}. A Unidade Centro tem
          estacionamento próprio. O atendimento é particular, com recibo e laudo para pedir reembolso ao plano de saúde.
        </p>
      </article>
      <aside class="aside">
        <div class="aside__box">
          <b>Agendar pelo WhatsApp</b>
          {UNITS.map((u) => (
            <a class="sheet__opt" href={wa(u.whatsapp, `${msg} Prefiro a ${u.name}.`)} target="_blank" rel="noopener">
              <span><b>{u.name}</b><small>{u.street}</small></span><Icon name="wa" />
            </a>
          ))}
        </div>
        <div>
          <p style="font-weight:600;margin-bottom:10px">Outros tratamentos</p>
          <div class="related">{others.map((o) => <a href={`/tratamentos/${o.slug}/`}>{o.title}</a>)}</div>
        </div>
      </aside>
    </div>
  </section>

  <section class="sec sand">
    <div class="wrap faq">
      <div><h2 class="d2">Perguntas frequentes.</h2></div>
      <div class="acc">
        {faq.map((f, i) => (
          <details open={i === 0}><summary><h3>{f.q}</h3><i aria-hidden="true"></i></summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta dark">
    <div class="wrap cta__in">
      <div>
        <h2 class="d2">Agende sua avaliação.</h2>
        <p class="lead" style="margin-top:14px;margin-bottom:0">{t.title} com a Dra. Thuelen Mellão, em Brusque.</p>
      </div>
      <a class="btn" href={wa(UNITS[0].whatsapp, msg)} target="_blank" rel="noopener" data-pick data-msg={msg}><Icon name="wa" />Agendar pelo WhatsApp</a>
    </div>
  </section>
</Base>
