---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { Picture, getImage } from 'astro:assets';
import heroImg from '../assets/img/dra-thuelen-mellao-dentista-brusque.webp';
import recepcao from '../assets/img/real/recepcao-unidade-centro-dra-thuelen-brusque.jpg';
import sdFoto from '../assets/img/real/fotografia-odontologica-planejamento-sorriso.jpg';
import kidsDra from '../assets/img/real/dra-thuelen-odontopediatria-espaco-kids.jpg';
import draEspelho from '../assets/img/real/dra-thuelen-mellao-clinica-brusque.jpg';
import sdEspelho from '../assets/img/real/paciente-teste-sorriso-espelho-dra-thuelen.jpg';
import scanner from '../assets/img/real/escaneamento-intraoral-digital-dra-thuelen.jpg';
import kidsSelfie from '../assets/img/real/odontopediatria-sem-medo-dra-thuelen.jpg';
import consultorio from '../assets/img/real/consultorio-odontologico-centro-brusque.jpg';
import consultorio2 from '../assets/img/real/consultorio-odontologico-unidade-centro.jpg';
import consulta from '../assets/img/real/dra-thuelen-consulta-avaliacao-brusque.jpg';
import draRenda from '../assets/img/real/dra-thuelen-mellao-consultorio-brusque.jpg';
import kings1 from '../assets/img/real/dra-thuelen-kings-college-dental-hospital-londres.jpg';
import sdTablet from '../assets/img/real/planejamento-digital-sorriso-antes-depois-brusque.jpg';
import kidsCastelo from '../assets/img/real/espaco-kids-castelo-dentista-infantil-brusque.jpg';
import kidsBrinq from '../assets/img/real/brinquedoteca-odontopediatria-brusque.jpg';
import kidsBebe from '../assets/img/real/atendimento-bebe-odontopediatria-brusque.jpg';
import { BRAND, UNITS, TREATMENTS, REVIEWS, FAQ, RESULTS, CHAPTERS, DEFAULT_WA, wa } from '../data/site';

const site = Astro.site!.toString().replace(/\/$/, '');
const title = 'Dentista em Brusque | Dra. Thuelen Mellão';
const description =
  'Dentista em Brusque - SC: lentes de contato, facetas, alinhadores, implantes e dentista infantil com a Dra. Thuelen Mellão. Unidades no Centro e no Paquetá.';

const schema = [
  { '@type': 'WebPage', '@id': `${site}/#pagina`, url: `${site}/`, name: title, description, isPartOf: { '@id': `${site}/#site` }, about: { '@id': `${site}/#organizacao` }, inLanguage: 'pt-BR' },
  { '@type': 'FAQPage', '@id': `${site}/#faq`, mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  {
    '@type': 'ItemList',
    '@id': `${site}/#tratamentos`,
    name: 'Tratamentos do Centro Dra. Thuelen em Brusque',
    itemListElement: TREATMENTS.map((t, i) => ({
      '@type': 'ListItem', position: i + 1,
      item: { '@type': 'Service', name: t.title, description: t.text, url: `${site}/tratamentos/${t.slug}/`, provider: { '@id': `${site}/#organizacao` }, areaServed: { '@type': 'City', name: 'Brusque' } },
    })),
  },
];

// Reel do topo: só fotos reais da clínica. A 1ª carrega já; as demais depois do load.
const reelSrc = [
  { img: heroImg, cap: 'Dra. Thuelen Mellão · CRO-SC 17911', alt: 'Dra. Thuelen Mellão sorrindo em seu consultório em Brusque', pos: '50% 22%' },
  { img: recepcao, cap: 'Recepção da Unidade Centro', alt: 'Recepção da Unidade Centro do Centro Dra. Thuelen', pos: '50% 50%' },
  { img: sdFoto, cap: 'Fotos do sorriso para o planejamento', alt: 'Dra. Thuelen fotografando o sorriso de uma paciente', pos: '50% 40%' },
  { img: kidsDra, cap: 'Espaço kids da Unidade Centro', alt: 'Dra. Thuelen no espaço kids da clínica', pos: '50% 30%' },
  { img: draEspelho, cap: 'Dra. Thuelen na Unidade Centro', alt: 'Dra. Thuelen Mellão na clínica, refletida no espelho', pos: '50% 35%' },
];
const reel = await Promise.all(
  reelSrc.map(async (r) => {
    const s = await getImage({ src: r.img, width: 640, format: 'webp', quality: 72 });
    const l = await getImage({ src: r.img, width: Math.min(r.img.width, 900), format: 'webp', quality: 74 });
    return { ...r, s: s.src, l: l.src, set: `${s.src} 640w, ${l.src} ${Math.min(r.img.width, 900)}w` };
  }),
);

const chapterImg: Record<string, { img: ImageMetadata; alt: string }> = {
  estetica: { img: sdEspelho, alt: 'Paciente avaliando o novo sorriso no espelho com a Dra. Thuelen' },
  ortodontia: { img: scanner, alt: 'Dra. Thuelen fazendo escaneamento intraoral 3D' },
  infantil: { img: kidsSelfie, alt: 'Dra. Thuelen e paciente criança sorrindo no consultório' },
  implantes: { img: consultorio, alt: 'Consultório da Unidade Centro' },
  geral: { img: consultorio2, alt: 'Cadeira odontológica do consultório da Unidade Centro' },
  sono: { img: consulta, alt: 'Dra. Thuelen explicando o tratamento na mesa de atendimento' },
};
const bySlug = Object.fromEntries(TREATMENTS.map((t) => [t.slug, t]));
const labels: Record<string, string> = { estetica: 'Estética', ortodontia: 'Ortodontia', infantil: 'Crianças', implantes: 'Reabilitação', geral: 'Clínica geral', sono: 'Sono e DTM' };

const msgOptions = [...TREATMENTS.map((t) => t.title), 'Consulta infantil', 'Ainda não sei, quero uma avaliação'];
const SIGNS = ['Os dentes estão nascendo amontoados, sem espaço', 'Ao morder, os dentes de baixo ficam à frente dos de cima', 'Já disseram que é melhor esperar a criança crescer'];
---
<Base title={title} description={description} schema={schema}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={reel[0].s} imagesrcset={reel[0].set} imagesizes="(min-width: 960px) 46vw, 100vw" fetchpriority="high" />
  </Fragment>

  <!-- TOPO: reel de fotos reais -->
  <section class="reel" aria-labelledby="h1" data-reel>
    <div class="reel__media">
      {reel.map((r, i) => (
        <div class:list={['reel__slide', i === 0 && 'is-on']} data-slide={i} data-cap={r.cap}>
          {i === 0
            ? <img src={r.s} srcset={r.set} sizes="(min-width: 960px) 46vw, 100vw" width={r.img.width} height={r.img.height} alt={r.alt} fetchpriority="high" decoding="async" style={`object-position:${r.pos}`} />
            : <img data-src={r.s} data-srcset={r.set} sizes="(min-width: 960px) 46vw, 100vw" width={r.img.width} height={r.img.height} alt={r.alt} decoding="async" style={`object-position:${r.pos}`} />}
        </div>
      ))}
    </div>
    <div class="wrap reel__body">
      <h1 class="d1 intro" id="h1">Dentista em Brusque.</h1>
      <p class="lead intro" style="--d:.1s">Lentes de contato, alinhadores, implantes e dentista infantil com a Dra. Thuelen Mellão. Unidades no Centro e no Paquetá.</p>
      <div class="btns intro" style="--d:.2s">
        <a class="btn" href={DEFAULT_WA} target="_blank" rel="noopener" data-pick><Icon name="wa" />Agendar avaliação</a>
        <a class="btn btn--line" href="#tratamentos">Ver tratamentos</a>
      </div>
      <div class="reel__bars" aria-label="Fotos da clínica">
        {reel.map((r, i) => <button type="button" class={i === 0 ? 'on' : ''} data-bar={i} aria-label={`Foto ${i + 1}: ${r.cap}`}></button>)}
      </div>
      <span class="reel__cap" data-reel-cap aria-live="polite">{reel[0].cap}</span>
    </div>
  </section>

  <div class="facts">
    <ul class="wrap">
      <li><b>CRO-SC 17911</b><span>Dra. Thuelen Mellão</span></li>
      <li><b>2 unidades</b><span>Centro e Paquetá</span></li>
      <li><b>Estacionamento</b><span>próprio na Unidade Centro</span></li>
      <li><b>Sedação</b><span>para crianças e adultos</span></li>
    </ul>
  </div>

  <!-- TRATAMENTOS -->
  <div class="tintro" id="tratamentos">
    <div class="wrap">
      <h2 class="d2" data-reveal>Tratamentos.</h2>
      <p class="lead" data-reveal style="margin-top:14px">Escolha pelo que você quer resolver. Cada tratamento tem uma página com mais detalhes.</p>
      <nav class="tjump" aria-label="Ir para o tratamento" data-reveal>
        {CHAPTERS.map((c) => <a href={`#${c.id}`}>{c.title}</a>)}
      </nav>
    </div>
  </div>

  {CHAPTERS.map((c) => {
    const ci = chapterImg[c.id];
    const msg = `Olá! Vim pelo site e quero agendar uma avaliação de ${c.title.toLowerCase()} com a Dra. Thuelen.`;
    return (
      <section class="chapter" id={c.id} aria-labelledby={`ch-${c.id}`}>
        <div class="chapter__img">
          <Picture src={ci.img} formats={['avif']} fallbackFormat="webp" widths={[480, 720]} sizes="(min-width: 960px) 50vw, 100vw" alt={ci.alt} loading="lazy" />
        </div>
        <div class="chapter__body wrap">
          <span class="chapter__n">{labels[c.id]}</span>
          <h2 id={`ch-${c.id}`}>{c.title}</h2>
          <p>{c.text}</p>
          <nav class="chapter__list" aria-label={`Páginas sobre ${c.title.toLowerCase()}`}>
            {c.items.map((s) => <a href={`/tratamentos/${s}/`}>{bySlug[s].title}</a>)}
            {c.extra.map((e) => <span>{e}</span>)}
          </nav>
          <div class="btns">
            <a class="btn" href={wa(UNITS[0].whatsapp, msg)} target="_blank" rel="noopener" data-pick data-msg={msg}><Icon name="wa" />Agendar avaliação</a>
          </div>
        </div>
      </section>
    );
  })}

  <!-- A DENTISTA -->
  <section class="halves" id="dra-thuelen" aria-labelledby="dra-t">
    <div class="halves__img">
      <Picture src={draRenda} formats={['avif']} fallbackFormat="webp" widths={[480, 720]} sizes="(min-width: 960px) 50vw, 100vw" alt="Dra. Thuelen Mellão sorrindo no consultório" loading="lazy" />
    </div>
    <div class="halves__body">
      <h2 class="d2" id="dra-t" data-reveal>Dra. Thuelen Mellão.</h2>
      <p class="lead" data-reveal>Cirurgiã-dentista e responsável técnica pelo Centro Dra. Thuelen. Atende adultos e crianças nas duas unidades e acompanha cada caso do planejamento até depois do tratamento.</p>
      <blockquote class="quote" data-reveal>
        “Desde sempre, sou fascinada pelo corpo humano. Ele é uma máquina perfeita, e o sorriso é a porta de entrada.”
        <small>Dra. Thuelen Mellão</small>
      </blockquote>
      <dl class="spec" data-reveal>
        <div><dt>Registro</dt><dd>{BRAND.cro}</dd></div>
        <div><dt>Formação</dt><dd>Especialista em quatro áreas, mestranda e MBA</dd></div>
        <div><dt>Sedação</dt><dd>Habilitada para crianças e adultos</dd></div>
        <div><dt>Laser</dt><dd>Alta e baixa potência</dd></div>
        <div><dt>Na saúde</dt><dd>Mais de 10 anos</dd></div>
      </dl>
      <div class="kings" data-reveal>
        <Picture src={kings1} formats={['avif']} fallbackFormat="webp" widths={[160]} sizes="76px" alt="Dra. Thuelen no King’s College Dental Hospital, em Londres" loading="lazy" />
        <p>Esteve no <b>King’s College London</b>, referência em Odontologia e sede do Centre for Craniofacial &amp; Regenerative Biology. <a class="more" href={BRAND.instagramDra} target="_blank" rel="noopener">@dentistathuelen</a></p>
      </div>
    </div>
  </section>

  <!-- RESULTADOS -->
  <section class="sec dark" id="resultados" aria-labelledby="res-t">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="d2" id="res-t" data-reveal>Resultados.</h2>
        <p class="lead" data-reveal>Pacientes atendidos no Centro Dra. Thuelen. O formato e a cor dos dentes são planejados de acordo com os lábios e o rosto de cada pessoa.</p>
      </div>
      <div class="rgrid">
        <figure class="wide" data-reveal>
          <Picture src={sdTablet} formats={['avif']} fallbackFormat="webp" widths={[480, 720]} sizes="(min-width: 900px) 50vw, 100vw" alt="Planejamento digital do sorriso no tablet comparando antes e depois" loading="lazy" />
          <figcaption>Planejamento digital: antes e depois</figcaption>
        </figure>
        {RESULTS.map((r, i) => (
          <figure data-reveal style={`--d:${(i % 2) * 0.08}s`}>
            <Picture src={r.img} formats={['avif']} fallbackFormat="webp" widths={[320, 480]} sizes="(min-width: 900px) 25vw, 50vw" alt={r.alt} loading="lazy" />
          </figure>
        ))}
      </div>
      <p class="rnote">Mais casos no Instagram <a href={BRAND.instagramDra} target="_blank" rel="noopener">@dentistathuelen</a>.</p>
    </div>
  </section>

  <!-- COMPARATIVOS -->
  <section class="sec" aria-labelledby="cmp-t">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="d2" id="cmp-t" data-reveal>Qual tratamento escolher?</h2>
        <p class="lead" data-reveal>As duas dúvidas mais comuns no consultório. A indicação para o seu caso é feita na avaliação.</p>
      </div>
      <div class="cmp">
        <div data-reveal>
          <h3 class="cmp__t">Lentes de contato ou facetas?</h3>
          <div class="tscroll">
            <table class="table">
              <thead><tr><th scope="col"></th><th scope="col">Lentes de contato</th><th scope="col">Facetas</th></tr></thead>
              <tbody>
                <tr><th scope="row">Como é feita</th><td>Lâmina de porcelana pura, sob medida, em laboratório</td><td>Esculpida dente a dente, direto no consultório</td></tr>
                <tr><th scope="row">O que corrige</th><td>Desgaste, formato, fraturas leves e espaços entre os dentes</td><td>Formato, pequenas fraturas e cor</td></tr>
                <tr><th scope="row">Resultado</th><td>Depois da etapa de laboratório</td><td>Na mesma sessão</td></tr>
                <tr><th scope="row">Ponto forte</th><td>Preserva ao máximo o dente original</td><td>Mais ágil, com bom custo-benefício</td></tr>
              </tbody>
            </table>
          </div>
          <p class="cmp__foot"><a class="more" href="/tratamentos/lentes-de-contato-dental/">Lentes de contato <Icon name="arrow" /></a> &nbsp; <a class="more" href="/tratamentos/facetas-esteticas/">Facetas <Icon name="arrow" /></a></p>
        </div>
        <div data-reveal style="--d:.08s">
          <h3 class="cmp__t">Alinhador ou aparelho fixo?</h3>
          <div class="tscroll">
            <table class="table">
              <thead><tr><th scope="col"></th><th scope="col">Alinhador invisível</th><th scope="col">Aparelho fixo</th></tr></thead>
              <tbody>
                <tr><th scope="row">Como é</th><td>Placas transparentes e removíveis</td><td>Bráquetes metálicos, de safira ou autoligáveis</td></tr>
                <tr><th scope="row">Planejamento</th><td>Escaneamento digital 3D da boca</td><td>Avaliação da mordida e da arcada</td></tr>
                <tr><th scope="row">No dia a dia</th><td>Tira para comer e escovar</td><td>Fica fixo até o fim do tratamento</td></tr>
                <tr><th scope="row">Ponto forte</th><td>Discreto e previsível</td><td>Corrige mordida, apinhamento e espaços</td></tr>
              </tbody>
            </table>
          </div>
          <p class="cmp__foot"><a class="more" href="/tratamentos/alinhadores-invisiveis/">Alinhadores <Icon name="arrow" /></a> &nbsp; <a class="more" href="/tratamentos/aparelhos-ortodonticos/">Aparelhos <Icon name="arrow" /></a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="sec tealbg" aria-labelledby="steps-t">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="d2" id="steps-t" data-reveal>Como funciona a primeira consulta.</h2>
      </div>
      <ol class="steps">
        <li data-reveal><h3>Agendamento</h3><p>Você chama no WhatsApp da unidade e combina o horário com a recepção.</p></li>
        <li data-reveal style="--d:.06s"><h3>Avaliação</h3><p>A Dra. Thuelen conversa com você, examina e, se precisar, faz fotos ou escaneamento.</p></li>
        <li data-reveal style="--d:.12s"><h3>Plano</h3><p>Você recebe o plano explicado etapa por etapa: o que fazer, em que ordem e por quê.</p></li>
        <li data-reveal style="--d:.18s"><h3>Tratamento</h3><p>Começa no seu tempo, com acompanhamento antes, durante e depois.</p></li>
      </ol>
    </div>
  </section>

  <!-- MENSAGEM -->
  <section class="sec sand" id="avaliacao" aria-labelledby="msg-t">
    <div class="wrap msg">
      <div>
        <h2 class="d2" id="msg-t" data-reveal>Monte a mensagem para a clínica.</h2>
        <p class="lead" data-reveal style="margin-top:14px">Escolha o tratamento e a unidade. O texto fica pronto para enviar no WhatsApp da recepção.</p>
        <form class="form" data-msgform data-reveal>
          <label class="field"><span>O que você quer tratar?</span>
            <select name="t">
              {msgOptions.map((o) => <option>{o}</option>)}
            </select>
          </label>
          <fieldset class="field">
            <legend>Para quem é a consulta?</legend>
            <div class="seg">
              <label><input type="radio" name="p" value="mim" checked /><span>Para mim</span></label>
              <label><input type="radio" name="p" value="filho" /><span>Para meu filho(a)</span></label>
            </div>
          </fieldset>
          <fieldset class="field">
            <legend>Unidade</legend>
            <div class="seg">
              {UNITS.map((u, i) => <label><input type="radio" name="u" value={u.id} checked={i === 0} /><span>{u.name}</span></label>)}
            </div>
          </fieldset>
          <label class="field"><span>Seu nome <small style="font-weight:400;color:var(--muted)">(opcional)</small></span><input name="n" type="text" autocomplete="given-name" /></label>
          <label class="field"><span>Quer contar algo? <small style="font-weight:400;color:var(--muted)">(opcional)</small></span><textarea name="o" placeholder="Ex.: tenho medo de anestesia, sinto dor ao mastigar"></textarea></label>
          <a class="btn" href={DEFAULT_WA} target="_blank" rel="noopener" data-msgsend><Icon name="wa" />Abrir no WhatsApp</a>
        </form>
      </div>
      <div class="preview" data-reveal>
        <p class="preview__h">Prévia da mensagem</p>
        <div class="bubble" data-msgprev>Olá! Vim pelo site e gostaria de agendar uma avaliação com a Dra. Thuelen.</div>
        <small data-msgto>Vai para o WhatsApp da {UNITS[0].name}: {UNITS[0].phoneLabel}</small>
        <script type="application/json" data-units set:html={JSON.stringify(UNITS.map(({ id, name, whatsapp, phoneLabel }) => ({ id, name, whatsapp, phoneLabel })))} />
      </div>
    </div>
  </section>

  <!-- INFANTIL -->
  <section class="sec rosebg" id="infantil" aria-labelledby="kids-t">
    <div class="wrap kids">
      <div class="kids__photos" data-reveal>
        <figure><Picture src={kidsCastelo} formats={['avif']} fallbackFormat="webp" widths={[360, 540]} sizes="(min-width: 960px) 30vw, 55vw" alt="Castelo e brinquedos do espaço kids da Unidade Centro" loading="lazy" /></figure>
        <figure><Picture src={kidsBrinq} formats={['avif']} fallbackFormat="webp" widths={[280, 420]} sizes="(min-width: 960px) 22vw, 42vw" alt="Brinquedoteca da clínica com brinquedos e tapete com letras" loading="lazy" /></figure>
        <figure><Picture src={kidsBebe} formats={['avif']} fallbackFormat="webp" widths={[280, 420]} sizes="(min-width: 960px) 22vw, 42vw" alt="Dra. Thuelen atendendo um bebê" loading="lazy" /></figure>
      </div>
      <div>
        <h2 class="d2" id="kids-t" data-reveal>Dentista infantil em Brusque.</h2>
        <p class="lead" data-reveal style="margin-top:14px">A consulta das crianças tem tempo para elas se adaptarem, com brincadeira e uma linguagem que entendem. Na Unidade Centro há espaço kids com brinquedoteca, e a Dra. Thuelen é habilitada em sedação quando for necessário.</p>
        <blockquote class="quote" data-reveal>
          “Muito além de cuidar de dentes, eu quero transformar a maneira como as crianças enxergam a Odontologia.”
          <small>Dra. Thuelen Mellão</small>
        </blockquote>
        <div class="signs" data-signs data-reveal>
          <h3>Quando avaliar a mordida do seu filho</h3>
          <p>Na ortopedia funcional dos maxilares, o crescimento da criança ajuda no tratamento. Marque o que você percebe:</p>
          <ul>
            {SIGNS.map((s, i) => <li><button type="button" class="sign" aria-pressed="false" data-sign={i}><i><Icon name="check" /></i>{s}</button></li>)}
          </ul>
          <p class="signs__out" data-signs-out aria-live="polite"></p>
          <a class="btn" href={wa(UNITS[0].whatsapp, 'Olá! Quero agendar uma avaliação da mordida do meu filho(a) com a Dra. Thuelen.')} target="_blank" rel="noopener" data-signs-send data-pick data-msg="Olá! Quero agendar uma avaliação da mordida do meu filho(a) com a Dra. Thuelen."><Icon name="wa" />Agendar para meu filho</a>
          <p style="margin:14px 0 0"><a class="more" href="/tratamentos/ortopedia-funcional-dos-maxilares/">Ortopedia funcional dos maxilares <Icon name="arrow" /></a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- A CLÍNICA -->
  <section class="sec dark" id="clinica" aria-labelledby="clin-t">
    <div class="wrap clinic">
      <div class="clinic__video" data-reveal>
        <video muted loop playsinline preload="none" poster="/video/tour-clinica-poster.jpg" width="540" height="960" data-lazyvideo aria-label="Vídeo da Unidade Centro: recepção, espaço kids e consultórios">
          <source data-src="/video/tour-clinica-dra-thuelen-brusque.mp4" type="video/mp4" />
        </video>
        <span>Unidade Centro</span>
      </div>
      <div>
        <h2 class="d2" id="clin-t" data-reveal>A Unidade Centro por dentro.</h2>
        <p class="lead" data-reveal style="margin-top:14px">Recepção, espaço kids, consultórios e bloco cirúrgico na R. Rodrigues Alves, 249, no Centro de Brusque.</p>
        <ul class="amen">
          <li data-reveal><Icon name="pin" /><div><b>Estacionamento próprio</b><span>Para chegar e estacionar sem procurar vaga.</span></div></li>
          <li data-reveal><Icon name="scan" /><div><b>Escaneamento digital 3D</b><span>Usado no planejamento e nos alinhadores invisíveis.</span></div></li>
          <li data-reveal><Icon name="building" /><div><b>Bloco cirúrgico</b><span>Implantes e cirurgias feitos na própria clínica.</span></div></li>
          <li data-reveal><Icon name="kid" /><div><b>Espaço kids</b><span>Brinquedoteca para as crianças esperarem brincando.</span></div></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- AVALIAÇÕES -->
  <section class="sec" aria-labelledby="rev-t">
    <div class="wrap">
      <div class="sec__head"><h2 class="d2" id="rev-t" data-reveal>O que dizem os pacientes.</h2></div>
      <div class="revs">
        {REVIEWS.map((r, i) => (
          <blockquote class="rev" data-reveal style={`--d:${i * 0.06}s`}>
            <p>{r.text}</p>
            <footer>{r.name}<span>Paciente</span></footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- PERGUNTAS -->
  <section class="sec sand" id="duvidas" aria-labelledby="faq-t">
    <div class="wrap faq">
      <div>
        <h2 class="d2" id="faq-t" data-reveal>Perguntas frequentes.</h2>
        <p class="lead" data-reveal style="margin:14px 0 22px">Não achou sua dúvida? A recepção responde pelo WhatsApp.</p>
        <a class="btn btn--line" href={DEFAULT_WA} target="_blank" rel="noopener" data-pick data-reveal><Icon name="wa" />Perguntar no WhatsApp</a>
      </div>
      <div class="acc">
        {FAQ.map((f, i) => (
          <details open={i === 0}>
            <summary><h3>{f.q}</h3><i aria-hidden="true"></i></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ENDEREÇOS -->
  <section class="sec" id="contato" aria-labelledby="end-t">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="d2" id="end-t" data-reveal>Endereços.</h2>
        <p class="lead" data-reveal>Duas unidades em Brusque. Agende pelo WhatsApp da que for mais prática para você.</p>
      </div>
      <div class="units">
        {UNITS.map((u) => (
          <article class="unit" data-reveal>
            <div class="unit__map" data-map={u.embedUrl}>
              <div><Icon name="pin" /><b>{u.street}</b><br /><button type="button" class="btn btn--sm" style="margin-top:12px" data-map-load>Ver no mapa</button></div>
            </div>
            <div class="unit__body">
              <h3>{u.name}</h3>
              <dl>
                <div><dt>Endereço</dt><dd>{u.street}, {u.district}, Brusque - SC{u.postalCode ? `, ${u.postalCode}` : ''}</dd></div>
                <div><dt>WhatsApp</dt><dd>{u.phoneLabel}</dd></div>
                <div><dt>Destaque</dt><dd>{u.perks.join(' · ')}</dd></div>
                <div><dt>Atendimento</dt><dd>Particular, com recibo para reembolso</dd></div>
              </dl>
              <div class="btns">
                <a class="btn" href={wa(u.whatsapp, `Olá! Vim pelo site e gostaria de agendar uma avaliação na ${u.name}.`)} target="_blank" rel="noopener"><Icon name="wa" />Agendar nesta unidade</a>
                <a class="btn btn--line" href={u.mapsUrl} target="_blank" rel="noopener">Como chegar</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta dark" aria-labelledby="cta-t">
    <div class="wrap cta__in">
      <div>
        <h2 class="d2" id="cta-t">Agende sua avaliação.</h2>
        <p class="lead" style="margin-top:14px;margin-bottom:0">Fale com a recepção pelo WhatsApp e escolha a unidade.</p>
      </div>
      <a class="btn" href={DEFAULT_WA} target="_blank" rel="noopener" data-pick><Icon name="wa" />Agendar pelo WhatsApp</a>
    </div>
  </section>
</Base>
