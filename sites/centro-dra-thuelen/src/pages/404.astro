---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada | Centro Dra. Thuelen" noindex description="A página que você procurou não existe. Volte para o início do Centro Dra. Thuelen, dentista em Brusque - SC.">
    <section class="phero on-dark" style="min-height:80vh;display:grid;align-items:center">
    <div class="wrap">
      <span class="kicker">Erro 404</span>
      <h1 class="h1">Esta página <em>não existe.</em></h1>
      <p class="hero__lead">Mas o seu sorriso continua sendo prioridade por aqui.</p>
      <div class="hero__ctas"><a class="btn btn--blush" href="/">Voltar ao início</a></div>
    </div>
  </section>
</Base>
