---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada | Centro Dra. Thuelen" noindex description="A página que você procurou não existe. Volte para o início do Centro Dra. Thuelen, dentista em Brusque - SC.">
  <section class="phero" style="min-height:80svh">
    <div class="wrap phero__body">
      <h1 class="d1">Página não encontrada.</h1>
      <p class="lead">O endereço pode ter mudado. Volte para o início ou fale com a clínica.</p>
      <div class="btns"><a class="btn" href="/">Voltar ao início</a></div>
    </div>
  </section>
</Base>
