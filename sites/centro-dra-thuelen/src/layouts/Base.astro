---
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import Icon from '../components/Icon.astro';
import logo from '../assets/img/logo-dra-thuelen-mellao.png';
import { BRAND, UNITS, TREATMENTS, DEFAULT_WA } from '../data/site';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, schema = [], ogImage, noindex = false } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const og = ogImage ? new URL(ogImage, Astro.site).toString() : `${site}/og.jpg`;

// Entidade base, repetida em todas as páginas e referenciada por @id.
const ORG_ID = `${site}/#organizacao`;
const PERSON_ID = `${site}/#dra-thuelen`;
const baseGraph = [
  {
    '@type': 'Organization',
    '@id': ORG_ID,
    name: BRAND.name,
    url: `${site}/`,
    logo: `${site}/icon-512.png`,
    sameAs: [BRAND.instagram],
    founder: { '@id': PERSON_ID },
    subOrganization: UNITS.map((u) => ({ '@id': `${site}/#unidade-${u.id}` })),
  },
  {
    '@type': 'Person',
    '@id': PERSON_ID,
    name: BRAND.doctor,
    jobTitle: BRAND.role,
    description: 'Cirurgiã-dentista em Brusque - SC, especialista em quatro áreas, mestranda e MBA. Habilitada em sedação para crianças e adultos, experiente com laser de alta e baixa potência e dedicada ao planejamento de sorrisos naturais e à ortopedia funcional dos maxilares na infância.',
    identifier: { '@type': 'PropertyValue', propertyID: 'CRO-SC', value: '17911' },
    worksFor: { '@id': ORG_ID },
    knowsAbout: ['Odontologia estética', 'Lentes de contato dental', 'Ortopedia Funcional dos Maxilares', 'Odontopediatria', 'Sedação odontológica', 'Laserterapia'],
    sameAs: [BRAND.instagramDra],
  },
  ...UNITS.map((u) => ({
    '@type': 'Dentist',
    '@id': `${site}/#unidade-${u.id}`,
    name: `${BRAND.name} – ${u.name}`,
    url: `${site}/`,
    image: `${site}/og.jpg`,
    telephone: `+${u.whatsapp}`,
    parentOrganization: { '@id': ORG_ID },
    employee: { '@id': PERSON_ID },
    hasMap: u.mapsUrl,
    address: {
      '@type': 'PostalAddress',
      streetAddress: u.street,
      addressLocality: BRAND.city,
      addressRegion: BRAND.region,
      ...(u.postalCode ? { postalCode: u.postalCode } : {}),
      addressCountry: 'BR',
    },
    areaServed: BRAND.areaServed.map((c) => ({ '@type': 'City', name: c })),
    paymentAccepted: 'Atendimento particular com recibo para reembolso',
    medicalSpecialty: ['Dentistry'],
  })),
  {
    '@type': 'WebSite',
    '@id': `${site}/#site`,
    url: `${site}/`,
    name: BRAND.name,
    inLanguage: 'pt-BR',
    publisher: { '@id': ORG_ID },
  },
];
const ld = { '@context': 'https://schema.org', '@graph': [...baseGraph, ...schema] };
const isHome = Astro.url.pathname === '/';
const h = (id: string) => (isHome ? `#${id}` : `/#${id}`);
const logoSm = (await getImage({ src: logo, width: 96, format: 'webp' })).src;
---
<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#121a19" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="preload" href="/fonts/inter-tight-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.replace('no-js','js')</script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>

    <header class="hdr" data-hdr>
      <div class="wrap hdr__in">
        <a class="brand" href="/">
          <img src={logoSm} width="40" height="40" alt="" />
          <span><b>Dra. Thuelen Mellão</b><small>Odontologia em Brusque</small></span>
        </a>
        <nav class="nav" aria-label="Principal">
          <a href={h('tratamentos')}>Tratamentos</a>
          <a href={h('dra-thuelen')}>A dentista</a>
          <a href={h('resultados')}>Resultados</a>
          <a href={h('infantil')}>Infantil</a>
          <a href={h('clinica')}>A clínica</a>
          <a href={h('contato')}>Endereços</a>
        </nav>
        <a class="btn btn--sm hdr__cta" href={DEFAULT_WA} target="_blank" rel="noopener" data-pick>Agendar</a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mnav" data-burger><span class="menu-btn__i" aria-hidden="true"></span><span data-burger-label>Menu</span></button>
      </div>
    </header>

    <nav class="mnav" id="mnav" aria-label="Menu">
      <a href={h('tratamentos')}>Tratamentos</a>
      <a href={h('dra-thuelen')}>A dentista</a>
      <a href={h('resultados')}>Resultados</a>
      <a href={h('infantil')}>Dentista infantil</a>
      <a href={h('clinica')}>A clínica</a>
      <a href={h('duvidas')}>Perguntas</a>
      <a href={h('contato')}>Endereços</a>
      <div class="mnav__foot">
        {UNITS.map((u) => <a href={`https://wa.me/${u.whatsapp}`} target="_blank" rel="noopener">{u.name} · {u.phoneLabel}</a>)}
      </div>
    </nav>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="ftr">
      <div class="wrap">
        <div class="ftr__grid">
          <div>
            <a class="brand brand--ftr" href="/">
              <Image src={logo} alt="Logo Dra. Thuelen Mellão" width={48} height={48} densities={[1, 2]} loading="lazy" />
              <span><b>Centro Dra. Thuelen</b><small>Odontologia em Brusque - SC</small></span>
            </a>
            <p class="ftr__about">Clínica odontológica da Dra. Thuelen Mellão, com unidades no Centro e no Paquetá, em Brusque.</p>
          </div>
          <div>
            <p class="ftr__h">Tratamentos</p>
            <ul>
              {TREATMENTS.map((t) => <li><a href={`/tratamentos/${t.slug}/`}>{t.title}</a></li>)}
            </ul>
          </div>
          <div>
            <p class="ftr__h">Unidades</p>
            <ul>
              {UNITS.map((u) => (
                <li class="ftr__unit">
                  <b>{u.name}</b>
                  <span>{u.street}, {u.district}</span>
                  <a href={`https://wa.me/${u.whatsapp}`} target="_blank" rel="noopener">WhatsApp {u.phoneLabel}</a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <p class="ftr__h">Redes</p>
            <ul>
              <li><a href={BRAND.instagram} target="_blank" rel="noopener">@centrodrathuelen</a></li>
              <li><a href={BRAND.instagramDra} target="_blank" rel="noopener">@dentistathuelen</a></li>
            </ul>
          </div>
        </div>
        <div class="ftr__legal">
          <span>Responsável técnica: {BRAND.doctor} · {BRAND.cro}</span>
          <span>© {new Date().getFullYear()} {BRAND.name}</span>
          <a class="ftr__credit" href="https://metodohopestart.com.br/" target="_blank" rel="noopener" aria-label="Site desenvolvido pela Hope Performance Digitais">
            <img src="/hope-credit.webp" width="96" height="39" loading="lazy" decoding="async" alt="Hope Performance Digitais" />
          </a>
        </div>
      </div>
    </footer>

    <nav class="mbar" aria-label="Ações rápidas" data-mbar>
      <a href={h('contato')}><Icon name="pin" /><span>Endereços</span></a>
      <a class="mbar__wa" href={DEFAULT_WA} target="_blank" rel="noopener" data-pick><Icon name="wa" /><span>Agendar avaliação</span></a>
    </nav>

    <dialog class="sheet" data-sheet aria-labelledby="sheet-t">
      <form method="dialog" class="sheet__in">
        <button class="sheet__x" value="close" aria-label="Fechar">×</button>
        <h2 id="sheet-t" class="sheet__t">Em qual unidade?</h2>
        <p class="sheet__sub">Você fala direto com a recepção da unidade escolhida.</p>
        {UNITS.map((u) => (
          <a class="sheet__opt" href={`https://wa.me/${u.whatsapp}?text=${encodeURIComponent(`Olá! Vim pelo site e gostaria de agendar uma avaliação com a Dra. Thuelen na ${u.name}.`)}`} target="_blank" rel="noopener" data-unit-link>
            <span><b>{u.name}</b><small>{u.street} · {u.perks[0]}</small></span>
            <Icon name="wa" />
          </a>
        ))}
      </form>
    </dialog>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
