---
// Quebra o título em palavras no build (sem JS de split = sem CLS).
// Use *texto* para marcar trecho em itálico de destaque.
interface Props { text: string; as?: string; class?: string; delay?: number; id?: string }
const { text, as: Tag = 'h2', class: cls = '', delay = 0, id } = Astro.props;
let i = 0;
const parts = text.split(/(\*[^*]+\*)/).filter(Boolean).map((chunk) => {
  const em = chunk.startsWith('*') && chunk.endsWith('*');
  const words = (em ? chunk.slice(1, -1) : chunk).split(/\s+/).filter(Boolean);
  return { em, words: words.map((w) => ({ w, i: i++ })) };
});
---
<Tag class:list={['split', cls]} data-split style={`--d:${delay}s`} id={id}>
  {parts.map((p) => {
    const inner = p.words.map((x) => (
      <Fragment><span class="w"><span style={`--i:${x.i}`}>{x.w}</span></span>{' '}</Fragment>
    ));
    return p.em ? <em>{inner}</em> : <Fragment>{inner}</Fragment>;
  })}
</Tag>
